# Required: your Anthropic API key (server-side only; never exposed to the browser)
ANTHROPIC_API_KEY=

# Optional: override the model (default claude-sonnet-5-5; set claude-opus-5-5 for Opus)
# CLAUDE_MODEL=claude-sonnet-5-5

# Optional: if set, visitors must enter this code before Alex will talk to them.
# Recommended for any public deployment, since every interview spends your API credits.
# ACCESS_CODE=

# Optional: voice interviews. URL of the speech server in speech-server/ (e.g. http://127.0.0.1:8001)
# and the same SPEECH_API_KEY you started it with. Leave unset for text-only interviews.
# SPEECH_URL=http://127.0.0.1:8001
# SPEECH_API_KEY=
